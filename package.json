{
  "name": "academia",
  "private": true,
  "version": "1.0.0",
  "description": "The Deterministic Student Notebook & Workbench",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit:security": "node scripts/audit-gate.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src/**",
    "check": "npm run typecheck && npm run audit:security && npm run test && npm run build"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "22.19.17",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^27.4.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19"
  }
}
