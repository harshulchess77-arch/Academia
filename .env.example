# ==============================================================================
# ACADEMIA GLOBAL ENVIRONMENT CONFIGURATION MATRIX (.env.example)
# ==============================================================================

# Application Runtime Environment
# Permitted values: 'production' | 'development' | 'test'
VITE_APP_ENV=development

# Sandbox & Local Mock Fallback Allowance
# In 'production', setting this to 'false' strictly forbids unauthenticated mock data rollback.
# Must be 'true' in development or sandbox evaluation.
VITE_ALLOW_MOCK_FALLBACK=true

# Supabase Production BaaS Endpoint URL (Strict HTTPS required in production)
# Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anonymous Key
# Used for unprivileged client-side RLS queries and token exchanges.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# High-Assurance Cryptography Configuration
# Minimum PBKDF2-SHA-256 iterations for AES-256-GCM vault containers (Must be >= 600000)
VITE_CRYPTO_MIN_PBKDF2_ITERATIONS=600000

# Default Student Privacy & Compliance Jurisdiction
# Permitted values: 'IN-DPDP' (India DPDP Act 2023) | 'EU-GDPR' (GDPR-K) | 'US-COPPA' (COPPA)
VITE_DEFAULT_COMPLIANCE_JURISDICTION=IN-DPDP

# Cloudflare Turnstile Human Verification Site Key
# Used to enforce CAPTCHA verification on authentication and prevent automated credential attacks.
# Example: 0x4AAAAAAAx... or 1x00000000000000000000AA for testing
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA


